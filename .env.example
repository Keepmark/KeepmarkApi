# Copy to .env and set real passwords before first `docker compose up`.
# Never commit .env.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
XBROWSERSYNC_DB_USER=xbrowsersyncdb
XBROWSERSYNC_DB_PWD=change-me-app
# Host port for the API (container always listens on 8080).
API_PORT=8080
# Static verbosity: trace|debug|info|warn|error|fatal (default info).
# Takes effect on (re)create. For on-the-fly changes see README "Verbosity".
LOG_LEVEL=info
